#!/bin/bash

CONFIG="/etc/NetworkManager/NetworkManager.conf"

CURRENT=$(grep -oP '^wifi\.scan-rand-mac-address=\K.*' "$CONFIG" 2>/dev/null)

if [ "$CURRENT" = "yes" ]; then
    NEW_SCAN="no"; NEW_CLONED="permanent"
    STATE="off"
else
    NEW_SCAN="yes"; NEW_CLONED="random"
    STATE="on"
fi

sed -i \
    -e 's/^wifi\.scan-rand-mac-address=.*/wifi.scan-rand-mac-address='"$NEW_SCAN"'/' \
    -e 's/^wifi\.cloned-mac-address=.*/wifi.cloned-mac-address='"$NEW_CLONED"'/' \
    "$CONFIG"

grep -q '^wifi\.scan-rand-mac-address=' "$CONFIG" || \
    sed -i '/^\[device\]/a wifi.scan-rand-mac-address='"$NEW_SCAN" "$CONFIG"
grep -q '^wifi\.cloned-mac-address=' "$CONFIG" || \
    sed -i '/^\[connection\]/a wifi.cloned-mac-address='"$NEW_CLONED" "$CONFIG"

nmcli general reload
nmcli connection down "Islington College" 2>/dev/null
nmcli connection up "Islington College" 2>/dev/null
sudo -u light_roronoa DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u light_roronoa)/bus" notify-send -t 3000 "MAC Spoofing $STATE"
